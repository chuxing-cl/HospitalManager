    <!--        SELECT-->
    <!--        ds.schedule_id,-->
    <!--        ds.doctor_id,-->
    <!--        ds.department_id,-->
    <!--        ds.date,-->
    <!--        ds.shift_time,-->
    <!--        d.name AS doctor_name,-->
    <!--        de.department_name AS dept_name-->
    <!--        FROM doctor_schedule ds  &lt;!&ndash; 修正表名：单数形式 &ndash;&gt;-->
    <!--        LEFT JOIN doctors d ON ds.doctor_id = d.doctor_id-->
    <!--        LEFT JOIN departments de ON ds.department_id = de.department_id-->
    <!--        WHERE ds.schedule_id = #{scheduleId}-->
    <!--    </select>-->
    <select id="Edit_findById" resultMap="ScheduleResultMap">
        SELECT
        s.schedule_id,
        s.doctor_id,
        s.department_id,
        s.date,          <!-- 显式添加日期字段 -->
        s.shift_time,
        d.name AS doctor_name,
        dept.department_name AS dept_name
        FROM doctor_schedule s
        LEFT JOIN doctors d ON s.doctor_id = d.doctor_id
        LEFT JOIN departments dept ON s.department_id = dept.department_id
        WHERE s.schedule_id = #{schedule_id}
    </select>
</mapper>